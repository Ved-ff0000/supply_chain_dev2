# ======================================================
# SupplyChain Notification Hub — backend configuration
# ======================================================
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.

# ------------------------------------------------------
# Server
# ------------------------------------------------------
PORT=5000
NODE_ENV=development

# Public URL of the frontend. Used to build the links inside password-reset
# and email-verification messages, so it must be reachable by the recipient.
APP_URL=http://localhost:4173

# ------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------
#
# The application reads the DB_* variables. DATABASE_URL is optional and is
# only used by the migration runner, which expands it into the DB_* values.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_chain_db
DB_USER=postgres
DB_PASSWORD=your_database_password

# DATABASE_URL=postgres://postgres:your_database_password@localhost:5432/supply_chain_db

# ------------------------------------------------------
# JWT / sessions
# ------------------------------------------------------
#
# JWT_SECRET signs the short-lived access token. Use a long random string,
# e.g. `openssl rand -hex 32`. Rotating it invalidates every access token.
#
# Refresh tokens are opaque random values stored only as SHA-256 hashes and
# rotated on every use, so they are not affected by JWT_SECRET.

JWT_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Legacy single-token lifetime, still honoured if JWT_ACCESS_EXPIRES is unset.
JWT_EXPIRES_IN=15m

# ------------------------------------------------------
# Email (Nodemailer)
# ------------------------------------------------------
#
# EMAIL_MODE controls the transport when no SMTP host is configured:
#   ethereal  create a throwaway test inbox at boot and log a preview URL
#             for every message (default in development)
#   json      serialise messages to the log instead of sending
#
# Setting SMTP_HOST and SMTP_USER always takes priority and sends for real.

EMAIL_MODE=ethereal

# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

EMAIL_FROM="SupplyChain Hub" <no-reply@yourdomain.com>

# Password reset link lifetime, in minutes.
PASSWORD_RESET_TTL_MINUTES=60

# ------------------------------------------------------
# Real-time (Server-Sent Events)
# ------------------------------------------------------
#
# Live in-app notifications are delivered over SSE at
# GET /api/notifications/stream. Heartbeat comments keep the connection
# alive through proxies that close idle streams.

SSE_HEARTBEAT_MS=25000

# ------------------------------------------------------
# Background jobs
# ------------------------------------------------------
#
# Cron pattern for automated delay detection (default: every 15 minutes).

DELAY_DETECTION_CRON=*/15 * * * *

# ------------------------------------------------------
# Rate limiting (auth routes)
# ------------------------------------------------------
#
# Counters are stored in Postgres so limits survive restarts.

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_RESET_MAX=10
RATE_LIMIT_REFRESH_MAX=120

# ------------------------------------------------------
# Limits
# ------------------------------------------------------

# Maximum shipments accepted by PATCH /api/shipments/bulk-status.
BULK_STATUS_MAX=200
