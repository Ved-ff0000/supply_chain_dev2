# Database
DATABASE_URL=postgres://user:password@localhost:5432/supplychain

# JWT
JWT_SECRET=your_jwt_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Server
PORT=3000
NODE_ENV=development

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM="SupplyChain Hub" <no-reply@yourdomain.com>

# Delay detection cron pattern (optional)
DELAY_DETECTION_CRON="*/15 * * * *"

# WebSocket / SSE config
NOTIFICATIONS_SSE_PATH=/api/notifications/sse

# Other
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
